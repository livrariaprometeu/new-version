{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "redirects": [
    {
      "source": "/blog/data/artigo/:slug*",
      "destination": "/blog/artigo/:slug*",
      "permanent": true
    },

    {
      "source": "/blog/config/artigos.json",
      "destination": "/blog/artigos.json",
      "permanent": true
    },

    {
      "source": "/livros/data/livro/romeu-and-juliet-in",
      "destination": "/livros/romance/romeu-and-juliet-in",
      "permanent": true
    },

    {
      "source": "/livros/data/livro/a-riqueza-das-nacoes-pt",
      "destination": "/livros/economia/a-riqueza-das-nacoes-pt",
      "permanent": true
    },

    {
      "source": "/livros/data/livro/more-than-skin-deep-in",
      "destination": "/livros/pulp/more-than-skin-deep-in",
      "permanent": true
    },

    {
      "source": "/livros/data/livro/meditations-in",
      "destination": "/livros/filosofia/meditations-in",
      "permanent": true
    }
  ],

  "headers": [
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|svg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}